# Phase 1 supports OFFLINE paper-only dry runs. No live broker or network order client exists.
SIGNAL_VAULT_MODE=paper
SIGNAL_VAULT_BROKER=local_dry_run
SIGNAL_VAULT_ENABLE_NETWORK_ORDER_SUBMISSION=false
SIGNAL_VAULT_SYMBOL=BTC/USD
# When a genuine Alpaca paper adapter is introduced, its credentials will be read
# ONLY from a local secret store / environment, never this tracked example.

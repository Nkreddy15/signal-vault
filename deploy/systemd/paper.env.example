# Copy to /etc/signal-vault/paper.env, owner root:signalvault, mode 0640 or stricter.
# Do NOT commit the real file. Never put these values into chat or Git.
ALPACA_PAPER_KEY_ID=replace_in_secret_file
ALPACA_PAPER_SECRET_KEY=replace_in_secret_file

# READ-ONLY BY DEFAULT. Leave this unset during smoke/integration.
# Enabling actual broker PAPER order submission later requires the exact value:
# SIGNAL_VAULT_PAPER_ORDER_SUBMISSION=I_ACKNOWLEDGE_ALPACA_PAPER_ORDERS_ONLY

# Optional ML BUY-confirmation filter. BOTH paths are required if enabled.
# The promotion receipt must match the exact artifact and dataset fingerprint.
# This is provider-paper-shadow scope only; it is not live authorization.
# SIGNAL_VAULT_ML_ARTIFACT=/var/lib/signal-vault/ml/model.json
# SIGNAL_VAULT_ML_PROMOTION_RECEIPT=/var/lib/signal-vault/ml/promotion.json
